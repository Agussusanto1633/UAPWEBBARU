    {
      "name": "6. Bookings",
      "item": [
        {
          "name": "[USER] Show Create Booking Form",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Requested-With",
                "value": "XMLHttpRequest"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/bookings/create?category_id=1",
              "host": ["{{baseUrl}}"],
              "path": ["bookings", "create"],
              "query": [
                {
                  "key": "category_id",
                  "value": "1",
                  "description": "Filter service providers by category (optional)"
                }
              ]
            },
            "description": "Menampilkan form create booking (Authenticated User)"
          },
          "response": []
        },
        {
          "name": "[USER] Create Booking",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              },
              {
                "key": "X-Requested-With",
                "value": "XMLHttpRequest"
              }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "service_provider_id",
                  "value": "1",
                  "description": "ID service provider (required)"
                },
                {
                  "key": "booking_date",
                  "value": "2025-12-30",
                  "description": "Tanggal booking (>= hari ini, format YYYY-MM-DD)"
                },
                {
                  "key": "booking_time",
                  "value": "10:00",
                  "description": "Waktu booking (format HH:MM)"
                },
                {
                  "key": "customer_name",
                  "value": "John Doe",
                  "description": "Nama customer (required, min 3, max 100 karakter)"
                },
                {
                  "key": "customer_phone",
                  "value": "081234567890",
                  "description": "Nomor telepon (required, min 10, max 20 karakter)"
                },
                {
                  "key": "customer_address",
                  "value": "Jl. Contoh No. 123",
                  "description": "Alamat customer (optional, max 500 karakter)"
                },
                {
                  "key": "notes",
                  "value": "Mohon dicuci dengan detail",
                  "description": "Catatan tambahan (optional, max 500 karakter)"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/bookings",
              "host": ["{{baseUrl}}"],
              "path": ["bookings"]
            },
            "description": "Membuat booking baru (Authenticated User). Status default: pending"
          },
          "response": []
        },
        {
          "name": "[USER] My Bookings",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Requested-With",
                "value": "XMLHttpRequest"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/bookings/my-bookings",
              "host": ["{{baseUrl}}"],
              "path": ["bookings", "my-bookings"]
            },
            "description": "Menampilkan semua booking milik user yang sedang login dengan pagination"
          },
          "response": []
        },
        {
          "name": "[ADMIN] All Bookings",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Requested-With",
                "value": "XMLHttpRequest"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/bookings",
              "host": ["{{baseUrl}}"],
              "path": ["bookings"]
            },
            "description": "Menampilkan semua bookings dari semua users (Admin only)"
          },
          "response": []
        },
        {
          "name": "Show Booking Detail",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Requested-With",
                "value": "XMLHttpRequest"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/bookings/{{booking_id}}",
              "host": ["{{baseUrl}}"],
              "path": ["bookings", "{{booking_id}}"]
            },
            "description": "Menampilkan detail booking. Hanya admin atau pemilik booking yang bisa akses."
          },
          "response": []
        },
        {
          "name": "[ADMIN] Update Booking Status",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              },
              {
                "key": "X-Requested-With",
                "value": "XMLHttpRequest"
              }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "status",
                  "value": "confirmed",
                  "description": "Status: pending, confirmed, completed, cancelled"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/bookings/{{booking_id}}/status",
              "host": ["{{baseUrl}}"],
              "path": ["bookings", "{{booking_id}}", "status"]
            },
            "description": "Update status booking (Admin only)\n\nOptions:\n- pending: Menunggu konfirmasi\n- confirmed: Booking dikonfirmasi\n- completed: Booking selesai\n- cancelled: Booking dibatalkan"
          },
          "response": []
        },
        {
          "name": "[USER] Cancel Booking",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              },
              {
                "key": "X-Requested-With",
                "value": "XMLHttpRequest"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/bookings/{{booking_id}}/cancel",
              "host": ["{{baseUrl}}"],
              "path": ["bookings", "{{booking_id}}", "cancel"]
            },
            "description": "Batalkan booking dengan status 'pending' (User hanya bisa cancel booking sendiri)"
          },
          "response": []
        }
      ]
    }
  ]
}
